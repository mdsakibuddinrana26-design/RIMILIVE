rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Party Rooms
    match /partyRooms/{roomId} {

      // Logged-in users can see available rooms
      allow read: if request.auth != null;

      // Only the creator can create a room as host
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;

      // Only the real host can change/delete room controls
      allow update, delete: if request.auth != null
                            && resource.data.hostUid == request.auth.uid;

      // Room members
      match /members/{memberId} {

        // Logged-in users can see who is inside the room
        allow read: if request.auth != null;

        // A user can create/change/remove only their own member document
        allow create, update, delete: if request.auth != null
                                     && request.auth.uid == memberId;
      }
    }
  }
}
