@Composable
fun AuthenticatedHomeScreen(
    user: User,
    onLogoutClick: () -> Unit,
    modifier: Modifier = Modifier
) {
    var selectedTab by remember { mutableStateOf("Party") }

    val tabs = listOf("Follow", "Party", "Chat", "Top")

    Column(
        modifier = modifier
            .fillMaxSize()
            .background(Color(0xFFF7FFFC))
            .statusBarsPadding()
    ) {
        // Header
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .background(Color(0xFF079A7B))
                .padding(horizontal = 18.dp, vertical = 14.dp),
            horizontalArrangement = Arrangement.SpaceBetween,
            verticalAlignment = Alignment.CenterVertically
        ) {
            Column {
                Text(
                    text = "GAMI LIVE",
                    color = Color.White,
                    fontSize = 24.sp,
                    fontWeight = FontWeight.Bold
                )
                Text(
                    text = "Live People • Real Connections",
                    color = Color.White.copy(alpha = 0.85f),
                    fontSize = 11.sp
                )
            }

            Row(verticalAlignment = Alignment.CenterVertically) {
                Text(
                    text = "🪙 0",
                    color = Color.White,
                    fontWeight = FontWeight.Bold
                )
                Spacer(Modifier.width(12.dp))
                Text(text = "🎁", fontSize = 24.sp)
                Spacer(Modifier.width(10.dp))
                Text(text = "🔔", fontSize = 22.sp)
            }
        }

        // Banner
        Box(
            modifier = Modifier
                .padding(16.dp)
                .fillMaxWidth()
                .height(105.dp)
                .clip(RoundedCornerShape(20.dp))
                .background(Color(0xFFD9FFF1)),
            contentAlignment = Alignment.Center
        ) {
            Column(horizontalAlignment = Alignment.CenterHorizontally) {
                Text("🎮", fontSize = 28.sp)
                Text(
                    "Play Together • Meet New People",
                    color = Color(0xFF087A65),
                    fontSize = 18.sp,
                    fontWeight = FontWeight.Bold
                )
            }
        }

        // Follow / Party / Chat / Top
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = 18.dp),
            horizontalArrangement = Arrangement.SpaceEvenly
        ) {
            tabs.forEach { tab ->
                Column(
                    modifier = Modifier
                        .clickable { selectedTab = tab }
                        .padding(8.dp),
                    horizontalAlignment = Alignment.CenterHorizontally
                ) {
                    Text(
                        text = tab,
                        fontSize = 17.sp,
                        fontWeight = if (selectedTab == tab) FontWeight.Bold else FontWeight.Normal,
                        color = if (selectedTab == tab) Color(0xFF079A7B) else Color.DarkGray
                    )
                    if (selectedTab == tab) {
                        Box(
                            Modifier
                                .padding(top = 5.dp)
                                .width(32.dp)
                                .height(3.dp)
                                .background(
                                    Color(0xFF10B99A),
                                    RoundedCornerShape(10.dp)
                                )
                        )
                    }
                }
            }
        }

        // Filters
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = 18.dp, vertical = 12.dp),
            horizontalArrangement = Arrangement.spacedBy(10.dp)
        ) {
            Surface(
                modifier = Modifier.weight(1f),
                shape = RoundedCornerShape(24.dp),
                color = Color.White,
                border = BorderStroke(1.dp, Color(0xFFDCE7E4))
            ) {
                Text(
                    "🌍  All Countries  ▼",
                    modifier = Modifier.padding(13.dp),
                    textAlign = TextAlign.Center,
                    color = Color(0xFF455A55)
                )
            }

            Surface(
                modifier = Modifier.weight(1f),
                shape = RoundedCornerShape(24.dp),
                color = Color.White,
                border = BorderStroke(1.dp, Color(0xFFDCE7E4))
            ) {
                Text(
                    "🔥  Popular  ▼",
                    modifier = Modifier.padding(13.dp),
                    textAlign = TextAlign.Center,
                    color = Color(0xFF455A55)
                )
            }
        }

        // Tab content
        when (selectedTab) {
            "Follow" -> {
                Column(
                    modifier = Modifier.padding(horizontal = 18.dp, vertical = 16.dp)
                ) {
                    Text(
                        text = "People You Follow",
                        fontSize = 20.sp,
                        fontWeight = FontWeight.Bold
                    )
                    Spacer(modifier = Modifier.height(12.dp))
                    Text("No followed users yet")
                }
            }

            "Party" -> {
                Column(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(horizontal = 16.dp, vertical = 12.dp)
                ) {
                    Text(
                        text = "Party Rooms",
                        fontSize = 20.sp,
                        fontWeight = FontWeight.Bold
                    )

                    Spacer(modifier = Modifier.height(12.dp))

                    repeat(2) { row ->
                        Row(
                            modifier = Modifier.fillMaxWidth(),
                            horizontalArrangement = Arrangement.spacedBy(10.dp)
                        ) {
                            repeat(2) { column ->
                                val index = row * 2 + column + 1

                                Surface(
                                    modifier = Modifier
                                        .weight(1f)
                                        .height(180.dp),
                                    shape = RoundedCornerShape(18.dp),
                                    color = Color.White,
                                    shadowElevation = 2.dp
                                ) {
                                    Column(
                                        modifier = Modifier.padding(12.dp),
                                        verticalArrangement = Arrangement.SpaceBetween
                                    ) {
                                        Box(
                                            modifier = Modifier
                                                .fillMaxWidth()
                                                .height(105.dp)
                                                .clip(RoundedCornerShape(14.dp))
                                                .background(Color(0xFFE0F7F2)),
                                            contentAlignment = Alignment.Center
                                        ) {
                                            Text("👤", fontSize = 44.sp)
                                        }

                                        Text(
                                            text = "GAMI User $index",
                                            fontWeight = FontWeight.Bold,
                                            fontSize = 14.sp
                                        )

                                        Text(
                                            text = if (index % 2 == 0)
                                                "🟢 Online • 🇧🇩 Bangladesh"
                                            else
                                                "🔴 Offline • 🇴🇲 Oman",
                                            fontSize = 11.sp
                                        )
                                    }
                                }
                            }
                        }

                        Spacer(modifier = Modifier.height(10.dp))
                    }
                }
            }

            "Chat" -> {
    Column(
        modifier = Modifier
            .fillMaxWidth()
            .padding(horizontal = 16.dp, vertical = 12.dp)
    ) {
        Text(
            text = "Audio Call",
            fontSize = 20.sp,
            fontWeight = FontWeight.Bold
        )

        Text(
            text = "🟢 Online   🔴 Offline   •   Coins / minute",
            fontSize = 13.sp,
            modifier = Modifier.padding(top = 6.dp, bottom = 12.dp)
        )

        repeat(6) { index ->
            val online = index % 3 != 0

            Surface(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(vertical = 5.dp),
                shape = RoundedCornerShape(18.dp),
                color = Color.White,
                shadowElevation = 2.dp
            ) {
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(12.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Box(
                        modifier = Modifier
                            .size(54.dp)
                            .clip(RoundedCornerShape(50))
                            .background(Color(0xFFE0F7F1)),
                        contentAlignment = Alignment.Center
                    ) {
                        Text("👤", fontSize = 28.sp)
                    }

                    Spacer(modifier = Modifier.width(12.dp))

                    Column(modifier = Modifier.weight(1f)) {
                        Text(
                            text = "GAMI User ${index + 1}",
                            fontSize = 16.sp,
                            fontWeight = FontWeight.Bold
                        )
                        Text(
                            text = if (online) "🟢 Online" else "🔴 Offline",
                            fontSize = 13.sp
                        )
                        Text(
                            text = "🪙 20 coins / min",
                            fontSize = 12.sp
                        )
                    }

                    Button(
                        onClick = { },
                        enabled = online,
                        shape = RoundedCornerShape(50),
                        colors = ButtonDefaults.buttonColors(
                            containerColor = Color(0xFF00A98F)
                        )
                    ) {
                        Text("📞 Call")
                    }
                }
            }
        }
    }
}

"Top" -> {
                Text(
                    text = "Active Players",
                    fontSize = 20.sp,
                    fontWeight = FontWeight.Bold,
                    modifier = Modifier.padding(horizontal = 18.dp, vertical = 16.dp)
                )
            }
        }

        // Create room
        Button(
            onClick = { },
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = 28.dp, vertical = 8.dp)
                .height(54.dp),
            shape = RoundedCornerShape(28.dp),
            colors = ButtonDefaults.buttonColors(
                containerColor = Color(0xFF079A7B)
            )
        ) {
            Text(
                "🎮  Create a Room",
                fontSize = 17.sp,
                fontWeight = FontWeight.Bold
            )
        }

        // Bottom navigation
        NavigationBar(
            containerColor = Color.White
        ) {
            NavigationBarItem(
                selected = true,
                onClick = { },
                icon = { Text("⌂", fontSize = 23.sp) },
                label = { Text("Home") }
            )
            NavigationBarItem(
                selected = false,
                onClick = { },
                icon = { Text("⌕", fontSize = 23.sp) },
                label = { Text("Explore") }
            )
            NavigationBarItem(
                selected = false,
                onClick = { },
                icon = { Text("+", fontSize = 28.sp, fontWeight = FontWeight.Bold) },
                label = { Text("Post") }
            )
            NavigationBarItem(
                selected = false,
                onClick = { },
                icon = { Text("💬", fontSize = 20.sp) },
                label = { Text("Messages") }
            )
            NavigationBarItem(
                selected = false,
                onClick = { },
                icon = { Text("○", fontSize = 23.sp) },
                label = { Text("Profile") }
            )
        }
    }
}
