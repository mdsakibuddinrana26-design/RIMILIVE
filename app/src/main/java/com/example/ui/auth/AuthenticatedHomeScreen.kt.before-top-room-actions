@Composable
fun AuthenticatedHomeScreen(
    user: User,
    onLogoutClick: () -> Unit,
    modifier: Modifier = Modifier
) {
    var selectedTab by remember { mutableStateOf("Party") }
    var countryExpanded by remember { mutableStateOf(false) }
    var selectedCountry by remember { mutableStateOf("All Countries") }

    val tabs = listOf("Follow", "Party", "Chat", "Top")

    Column(
        modifier = modifier
            .fillMaxSize()
            .background(Color(0xFFF7FFFC))
            .statusBarsPadding()
    ) {
        // Header
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .background(Color(0xFF079A7B))
                .padding(horizontal = 18.dp, vertical = 14.dp),
            horizontalArrangement = Arrangement.SpaceBetween,
            verticalAlignment = Alignment.CenterVertically
        ) {
            Column {
                Text(
                    text = "GAMI LIVE",
                    color = Color.White,
                    fontSize = 24.sp,
                    fontWeight = FontWeight.Bold
                )
                Text(
                    text = "Live People • Real Connections",
                    color = Color.White.copy(alpha = 0.85f),
                    fontSize = 11.sp
                )
            }

            Row(verticalAlignment = Alignment.CenterVertically) {
                Text(
                    text = "🪙 0",
                    color = Color.White,
                    fontWeight = FontWeight.Bold
                )
                Spacer(Modifier.width(12.dp))
                Text(text = "🎁", fontSize = 24.sp)
                Spacer(Modifier.width(10.dp))
                Text(text = "🔔", fontSize = 22.sp)
            }
        }

        // Banner
        Box(
            modifier = Modifier
                .padding(16.dp)
                .fillMaxWidth()
                .height(105.dp)
                .clip(RoundedCornerShape(20.dp))
                .background(Color(0xFFD9FFF1)),
            contentAlignment = Alignment.Center
        ) {
            Column(horizontalAlignment = Alignment.CenterHorizontally) {
                Text("🎮", fontSize = 28.sp)
                Text(
                    "Play Together • Meet New People",
                    color = Color(0xFF087A65),
                    fontSize = 18.sp,
                    fontWeight = FontWeight.Bold
                )
            }
        }

        // Follow / Party / Chat / Top
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = 18.dp),
            horizontalArrangement = Arrangement.SpaceEvenly
        ) {
            tabs.forEach { tab ->
                Column(
                    modifier = Modifier
                        .clickable { selectedTab = tab }
                        .padding(8.dp),
                    horizontalAlignment = Alignment.CenterHorizontally
                ) {
                    Text(
                        text = tab,
                        fontSize = 17.sp,
                        fontWeight = if (selectedTab == tab) FontWeight.Bold else FontWeight.Normal,
                        color = if (selectedTab == tab) Color(0xFF079A7B) else Color.DarkGray
                    )
                    if (selectedTab == tab) {
                        Box(
                            Modifier
                                .padding(top = 5.dp)
                                .width(32.dp)
                                .height(3.dp)
                                .background(
                                    Color(0xFF10B99A),
                                    RoundedCornerShape(10.dp)
                                )
                        )
                    }
                }
            }
        }

        // Filters
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = 18.dp, vertical = 12.dp),
            horizontalArrangement = Arrangement.spacedBy(10.dp)
        ) {
            Column(
                modifier = Modifier.weight(1f)
            ) {
                Surface(
                    modifier = Modifier
                        .fillMaxWidth()
                        .clickable { countryExpanded = !countryExpanded },
                    shape = RoundedCornerShape(24.dp),
                    color = Color.White,
                    border = BorderStroke(1.dp, Color(0xFFDCE7E4))
                ) {
                    Text(
                        text = if (selectedCountry.contains("All")) "🌐 Region ▾" else selectedCountry + " ▾",
                        modifier = Modifier.padding(13.dp),
                        textAlign = TextAlign.Center,
                        color = Color(0xFF455A55)
                    )
                }

                if (countryExpanded) {
                    DropdownMenu(
                        expanded = countryExpanded,
                        onDismissRequest = { countryExpanded = false },
                        modifier = Modifier.width(330.dp)
                    ) {
                    Surface(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(top = 8.dp),
                        shape = RoundedCornerShape(14.dp),
                        color = Color(0xFFE8F8F1)
                    ) {
                        Column(modifier = Modifier.padding(10.dp)) {
                            Text(
                                text = "Region",
                                fontWeight = FontWeight.Bold,
                                color = Color(0xFF168A68),
                                modifier = Modifier.padding(bottom = 8.dp)
                            )

                            val countries = listOf(
                                "🌐 All",
                                "🇧🇩 Bangladesh",
                                "🇸🇦 Saudi Arabia",
                                "🇦🇪 United Arab Emirates",
                                "🇶🇦 Qatar",
                                "🇰🇼 Kuwait",
                                "🇮🇳 India",
                                "🇵🇰 Pakistan",
                                "🇳🇵 Nepal",
                                "🇵🇭 Philippines",
                                "🇮🇩 Indonesia",
                                "🇲🇾 Malaysia"
                            )

                            countries.chunked(3).forEach { rowCountries ->
                                Row(
                                    modifier = Modifier.fillMaxWidth(),
                                    horizontalArrangement = Arrangement.spacedBy(6.dp)
                                ) {
                                    rowCountries.forEach { country ->
                                        val isSelected = selectedCountry == country ||
                                            (country == "🌐 All" && selectedCountry.contains("All"))

                                        Surface(
                                            modifier = Modifier
                                                .weight(1f)
                                                .padding(vertical = 3.dp)
                                                .clickable {
                                                    selectedCountry = country
                                                    countryExpanded = false
                                                },
                                            shape = RoundedCornerShape(14.dp),
                                            color = if (isSelected)
                                                Color(0xFF20B486)
                                            else
                                                Color.White
                                        ) {
                                            Text(
                                                text = when (country) {
                                                    "🇦🇪 United Arab Emirates" -> "🇦🇪 UAE"
                                                    "🇸🇦 Saudi Arabia" -> "🇸🇦 Saudi"
                                                    "🇵🇭 Philippines" -> "🇵🇭 Philippines"
                                                    else -> country
                                                },
                                                modifier = Modifier.padding(
                                                    horizontal = 8.dp,
                                                    vertical = 9.dp
                                                ),
                                                textAlign = TextAlign.Center,
                                                color = if (isSelected)
                                                    Color.White
                                                else
                                                    Color(0xFF455A55),
                                                fontSize = 11.sp
                                            )
                                        }
                                    }

                                    if (rowCountries.size == 1) {
                                        Spacer(modifier = Modifier.weight(1f))
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }

            Surface(
                modifier = Modifier.weight(1f),
                shape = RoundedCornerShape(24.dp),
                color = Color.White,
                border = BorderStroke(1.dp, Color(0xFFDCE7E4))
            ) {
                Text(
                    "🔥  Popular  ▼",
                    modifier = Modifier.padding(13.dp),
                    textAlign = TextAlign.Center,
                    color = Color(0xFF455A55)
                )
            }
        }

        // Tab content
        when (selectedTab) {
            "Follow" -> {
                Column(
                    modifier = Modifier.padding(horizontal = 18.dp, vertical = 16.dp)
                ) {
                    Text(
                        text = "People You Follow",
                        fontSize = 20.sp,
                        fontWeight = FontWeight.Bold
                    )
                    Spacer(modifier = Modifier.height(12.dp))
                    Text("No followed users yet")
                }
            }

            "Party" -> {
    var selectedRoomSeat by remember { mutableStateOf(1) }
    var cameraEnabled by remember { mutableStateOf(false) }
    var showLeaveRoomDialog by remember { mutableStateOf(false) }

    // PK control
    val isHost = true
    var showPkMenu by remember { mutableStateOf(false) }
    var pkRunning by remember { mutableStateOf(false) }
    var pkMinutes by remember { mutableStateOf(0) }
    var showMoreMenu by remember { mutableStateOf(false) }
    var micEnabled by remember { mutableStateOf(true) }
    var speakerEnabled by remember { mutableStateOf(true) }

    var chatInput by remember { mutableStateOf("") }
    var showGameMenu by remember { mutableStateOf(false) }
    var showGiftMenu by remember { mutableStateOf(false) }
    var showCoinMenu by remember { mutableStateOf(false) }

    var roomMessages by remember {
        mutableStateOf(
            listOf(
                "System: Welcome to the room",
                "System: Users joining the room will appear here"
            )
        )
    }

    androidx.activity.compose.BackHandler {
        showLeaveRoomDialog = true
    }

    if (showGameMenu) {
        AlertDialog(
            onDismissRequest = { showGameMenu = false },
            title = { Text("Games") },
            text = {
                Column {
                    TextButton(onClick = { showGameMenu = false }) {
                        Text("PK Game")
                    }
                    TextButton(onClick = { showGameMenu = false }) {
                        Text("Lucky Race")
                    }
                    TextButton(onClick = { showGameMenu = false }) {
                        Text("More games later")
                    }
                }
            },
            confirmButton = {},
            dismissButton = {
                TextButton(onClick = { showGameMenu = false }) {
                    Text("Close")
                }
            }
        )
    }

    if (showGiftMenu) {
        AlertDialog(
            onDismissRequest = { showGiftMenu = false },
            title = { Text("Send Gift") },
            text = {
                Column {
                    listOf("Rose", "Heart", "Star", "Crown").forEach { gift ->
                        TextButton(
                            onClick = {
                                roomMessages = roomMessages + "You sent $gift"
                                showGiftMenu = false
                            }
                        ) {
                            Text(gift)
                        }
                    }
                }
            },
            confirmButton = {},
            dismissButton = {
                TextButton(onClick = { showGiftMenu = false }) {
                    Text("Close")
                }
            }
        )
    }

    if (showCoinMenu) {
        AlertDialog(
            onDismissRequest = { showCoinMenu = false },
            title = { Text("Coins") },
            text = {
                Text("Coin balance and recharge will be connected later.")
            },
            confirmButton = {},
            dismissButton = {
                TextButton(onClick = { showCoinMenu = false }) {
                    Text("Close")
                }
            }
        )
    }

    if (showMoreMenu) {
        AlertDialog(
            onDismissRequest = { showMoreMenu = false },
            title = { Text("More") },
            text = {
                Column {
                    TextButton(
                        onClick = {
                            showMoreMenu = false
                        }
                    ) {
                        Text("Create Room")
                    }

                    TextButton(
                        onClick = {
                            showMoreMenu = false
                        }
                    ) {
                        Text("Room Settings")
                    }

                    TextButton(
                        onClick = {
                            showMoreMenu = false
                        }
                    ) {
                        Text("Share Room")
                    }
                }
            },
            confirmButton = {},
            dismissButton = {
                TextButton(
                    onClick = { showMoreMenu = false }
                ) {
                    Text("Close")
                }
            }
        )
    }

    if (showPkMenu) {
        AlertDialog(
            onDismissRequest = { showPkMenu = false },
            title = { Text("Start PK") },
            text = {
                Column {
                    Text("Choose PK duration")
                    Spacer(modifier = Modifier.height(8.dp))

                    listOf(5, 10, 15).forEach { minutes ->
                        TextButton(
                            onClick = {
                                pkMinutes = minutes
                                pkRunning = true
                                showPkMenu = false
                            }
                        ) {
                            Text("$minutes minutes")
                        }
                    }

                    if (pkRunning) {
                        Spacer(modifier = Modifier.height(6.dp))
                        TextButton(
                            onClick = {
                                pkRunning = false
                                pkMinutes = 0
                                showPkMenu = false
                            }
                        ) {
                            Text("Stop PK")
                        }
                    }
                }
            },
            confirmButton = {},
            dismissButton = {
                TextButton(
                    onClick = { showPkMenu = false }
                ) {
                    Text("Cancel")
                }
            }
        )
    }

    if (showLeaveRoomDialog) {
        AlertDialog(
            onDismissRequest = { showLeaveRoomDialog = false },
            title = { Text("Leave this room?") },
            text = { Text("Do you want to leave the party room?") },
            confirmButton = {
                TextButton(
                    onClick = {
                        cameraEnabled = false
                        selectedRoomSeat = 1
                        showLeaveRoomDialog = false
                    }
                ) {
                    Text("Leave")
                }
            },
            dismissButton = {
                TextButton(
                    onClick = { showLeaveRoomDialog = false }
                ) {
                    Text("Cancel")
                }
            }
        )
    }

    Column(
        modifier = Modifier
            .fillMaxWidth()
            .padding(horizontal = 8.dp, vertical = 6.dp)
    ) {

        // Room top info
        Surface(
            modifier = Modifier.fillMaxWidth(),
            shape = RoundedCornerShape(18.dp),
            color = Color(0xFF123C42),
            shadowElevation = 3.dp
        ) {
            Column(modifier = Modifier.padding(12.dp)) {
                Text(
                    text = "S A K I B",
                    color = Color.White,
                    fontSize = 19.sp,
                    fontWeight = FontWeight.Bold
                )
                Text(
                    text = "Room ID: 123456   •   👥 1",
                    color = Color(0xFFD5EEEE),
                    fontSize = 12.sp
                )
            }
        }

        Spacer(modifier = Modifier.height(6.dp))

        // Notice + PK
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.spacedBy(6.dp)
        ) {
            Surface(
                modifier = Modifier.weight(1f),
                shape = RoundedCornerShape(14.dp),
                color = Color(0xFF1B555A)
            ) {
                Text(
                    text = "🔊  Notice Board",
                    modifier = Modifier.padding(10.dp),
                    color = Color.White,
                    fontSize = 13.sp
                )
            }

            Surface(
                modifier = Modifier
                    .weight(1f)
                    .clickable(enabled = isHost) {
                        showPkMenu = true
                    },
                shape = RoundedCornerShape(14.dp),
                color = if (pkRunning) Color(0xFF8A3D3D) else Color(0xFF234A63)
            ) {
                Text(
                    text = if (pkRunning)
                        "⚔ PK LIVE • ${pkMinutes}m"
                    else
                        "⚔ PK • Host Only",
                    modifier = Modifier.padding(10.dp),
                    color = Color.White,
                    fontSize = 12.sp,
                    textAlign = TextAlign.Center
                )
            }
        }

        Spacer(modifier = Modifier.height(8.dp))

        // TOP 5 CAMERA SEATS
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .height(245.dp),
            horizontalArrangement = Arrangement.spacedBy(6.dp)
        ) {

            // HOST - biggest camera seat
            Surface(
                modifier = Modifier
                    .weight(1.35f)
                    .fillMaxWidth()
                    .clickable {
                        selectedRoomSeat = 1
                    },
                shape = RoundedCornerShape(18.dp),
                color = Color(0xFF204A4D),
                border = BorderStroke(1.dp, Color(0xFFFFD86B))
            ) {
                Box(
                    modifier = Modifier.fillMaxWidth(),
                    contentAlignment = Alignment.Center
                ) {
                    Column(horizontalAlignment = Alignment.CenterHorizontally) {
                        Text("👤", fontSize = 52.sp)
                        Text(
                            "👑 HOST",
                            color = Color(0xFFFFD86B),
                            fontWeight = FontWeight.Bold
                        )
                        Text(
                            "S A K I B",
                            color = Color.White,
                            fontSize = 13.sp
                        )
                        Text(
                            "📷 Camera",
                            color = Color(0xFFB9F5E8),
                            fontSize = 11.sp
                        )
                    }
                }
            }

            // Camera seats 2-5
            Column(
                modifier = Modifier.weight(1f),
                verticalArrangement = Arrangement.spacedBy(6.dp)
            ) {
                repeat(2) { rowIndex ->
                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .weight(1f),
                        horizontalArrangement = Arrangement.spacedBy(6.dp)
                    ) {
                        repeat(2) { colIndex ->
                            val seatNo = 2 + rowIndex * 2 + colIndex

                            Surface(
                                modifier = Modifier
                                    .weight(1f)
                                    .fillMaxWidth()
                                    .clickable {
                                        selectedRoomSeat = seatNo
                                    },
                                shape = RoundedCornerShape(16.dp),
                                color = if (selectedRoomSeat == seatNo)
                                    Color(0xFF267A78)
                                else
                                    Color(0xFF315D61),
                                border = BorderStroke(
                                    1.dp,
                                    Color(0xFF6FD9D1)
                                )
                            ) {
                                Box(
                                    contentAlignment = Alignment.Center
                                ) {
                                    Column(
                                        horizontalAlignment = Alignment.CenterHorizontally
                                    ) {
                                        Text(
                                            "+",
                                            fontSize = 29.sp,
                                            color = Color.White
                                        )
                                        Text(
                                            "Seat $seatNo",
                                            color = Color.White,
                                            fontSize = 11.sp
                                        )
                                        Text(
                                            "📷",
                                            fontSize = 13.sp
                                        )
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Spacer(modifier = Modifier.height(8.dp))

        // AUDIO ONLY SEATS
        Text(
            text = "Audio Seats",
            color = Color(0xFF28565B),
            fontWeight = FontWeight.Bold,
            fontSize = 13.sp
        )

        Spacer(modifier = Modifier.height(4.dp))

        repeat(2) { rowIndex ->
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.spacedBy(5.dp)
            ) {
                repeat(5) { colIndex ->
                    val seatNo = 6 + rowIndex * 5 + colIndex

                    Surface(
                        modifier = Modifier
                            .weight(1f)
                            .height(70.dp)
                            .clickable {
                                selectedRoomSeat = seatNo
                                cameraEnabled = false
                            },
                        shape = RoundedCornerShape(16.dp),
                        color = if (selectedRoomSeat == seatNo)
                            Color(0xFFC6E9E4)
                        else
                            Color(0xFFE5F4F1),
                        border = BorderStroke(
                            1.dp,
                            Color(0xFF9CCDC7)
                        )
                    ) {
                        Column(
                            modifier = Modifier.padding(4.dp),
                            horizontalAlignment = Alignment.CenterHorizontally,
                            verticalArrangement = Arrangement.Center
                        ) {
                            Text(
                                "+",
                                fontSize = 22.sp,
                                color = Color(0xFF326A6E)
                            )
                            Text(
                                "$seatNo",
                                fontSize = 10.sp,
                                color = Color(0xFF326A6E)
                            )
                            Text(
                                "Invite",
                                fontSize = 9.sp,
                                color = Color(0xFF54787A)
                            )
                        }
                    }
                }
            }

            Spacer(modifier = Modifier.height(5.dp))
        }

        Spacer(modifier = Modifier.height(4.dp))

        // Chat/System area
        Surface(
            modifier = Modifier.fillMaxWidth(),
            shape = RoundedCornerShape(16.dp),
            color = Color(0xFFE7F5F2)
        ) {
            Column(modifier = Modifier.padding(10.dp)) {
                Text(
                    text = "All     Chat     System",
                    color = Color(0xFF166B67),
                    fontWeight = FontWeight.Bold,
                    fontSize = 12.sp
                )

                Spacer(modifier = Modifier.height(6.dp))

                roomMessages.takeLast(4).forEach { message ->
                    Text(
                        text = message,
                        color = Color(0xFF36585A),
                        fontSize = 10.sp,
                        modifier = Modifier.padding(vertical = 2.dp)
                    )
                }

                Spacer(modifier = Modifier.height(8.dp))

                Row(
                    modifier = Modifier.fillMaxWidth(),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    OutlinedTextField(
                        value = chatInput,
                        onValueChange = { chatInput = it },
                        modifier = Modifier.weight(1f),
                        placeholder = {
                            Text(
                                text = "Enter something...",
                                fontSize = 11.sp
                            )
                        },
                        singleLine = true,
                        shape = RoundedCornerShape(14.dp)
                    )

                    Spacer(modifier = Modifier.width(6.dp))

                    Surface(
                        modifier = Modifier
                            .clickable {
                                val msg = chatInput.trim()
                                if (msg.isNotEmpty()) {
                                    roomMessages = roomMessages + "You: $msg"
                                    chatInput = ""
                                }
                            },
                        shape = RoundedCornerShape(14.dp),
                        color = Color(0xFF168C78)
                    ) {
                        Text(
                            text = "Send",
                            modifier = Modifier.padding(
                                horizontal = 12.dp,
                                vertical = 12.dp
                            ),
                            color = Color.White,
                            fontSize = 11.sp,
                            fontWeight = FontWeight.Bold
                        )
                    }
                }
            }
        }

        Spacer(modifier = Modifier.height(7.dp))

        // Room actions
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.spacedBy(6.dp)
        ) {
            listOf(
                "Chat" to "💬",
                "Game" to "🎮",
                "Gift" to "🎁",
                "Coin" to "🪙"
            ).forEach { (label, icon) ->
                Surface(
                    modifier = Modifier
                        .weight(1f)
                        .clickable {
                            when (label) {
                                "Chat" -> {
                                    roomMessages = roomMessages + "System: Chat ready"
                                }
                                "Game" -> showGameMenu = true
                                "Gift" -> showGiftMenu = true
                                "Coin" -> showCoinMenu = true
                            }
                        },
                    shape = RoundedCornerShape(15.dp),
                    color = Color(0xFF245F63)
                ) {
                    Text(
                        text = "$icon\n$label",
                        modifier = Modifier.padding(vertical = 8.dp),
                        textAlign = TextAlign.Center,
                        color = Color.White,
                        fontSize = 11.sp
                    )
                }
            }
        }

        Spacer(modifier = Modifier.height(7.dp))

        // Bottom controls - NO Leave Room
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.SpaceEvenly
        ) {
            Surface(
                modifier = Modifier
                    .weight(1f)
                    .padding(horizontal = 3.dp)
                    .clickable {
                        micEnabled = !micEnabled
                    },
                shape = RoundedCornerShape(15.dp),
                color = if (micEnabled)
                    Color(0xFF168C78)
                else
                    Color(0xFF6E7F80)
            ) {
                Text(
                    text = if (micEnabled)
                        "🎤\nMic ON"
                    else
                        "🔇\nMic OFF",
                    modifier = Modifier.padding(vertical = 8.dp),
                    textAlign = TextAlign.Center,
                    color = Color.White,
                    fontSize = 11.sp
                )
            }

            Surface(
                modifier = Modifier
                    .weight(1f)
                    .padding(horizontal = 3.dp)
                    .clickable {
                        speakerEnabled = !speakerEnabled
                    },
                shape = RoundedCornerShape(15.dp),
                color = if (speakerEnabled)
                    Color(0xFF168C78)
                else
                    Color(0xFF6E7F80)
            ) {
                Text(
                    text = if (speakerEnabled)
                        "🔊\nSpeaker ON"
                    else
                        "🔈\nSpeaker OFF",
                    modifier = Modifier.padding(vertical = 8.dp),
                    textAlign = TextAlign.Center,
                    color = Color.White,
                    fontSize = 11.sp
                )
            }

            Surface(
                modifier = Modifier
                    .weight(1f)
                    .padding(horizontal = 3.dp)
                    .clickable(enabled = selectedRoomSeat <= 5) {
                        cameraEnabled = !cameraEnabled
                    },
                shape = RoundedCornerShape(15.dp),
                color = when {
                    selectedRoomSeat > 5 -> Color(0xFF789092)
                    cameraEnabled -> Color(0xFF168C78)
                    else -> Color(0xFF174D52)
                }
            ) {
                Text(
                    text = if (selectedRoomSeat > 5)
                        "🚫\nCamera"
                    else if (cameraEnabled)
                        "📷\nCamera ON"
                    else
                        "📷\nCamera",
                    modifier = Modifier.padding(vertical = 8.dp),
                    textAlign = TextAlign.Center,
                    color = Color.White,
                    fontSize = 11.sp
                )
            }

            Surface(
                modifier = Modifier
                    .weight(1f)
                    .padding(horizontal = 3.dp)
                    .clickable {
                        showMoreMenu = true
                    },
                shape = RoundedCornerShape(15.dp),
                color = Color(0xFF174D52)
            ) {
                Text(
                    text = "•••\nMore",
                    modifier = Modifier.padding(vertical = 8.dp),
                    textAlign = TextAlign.Center,
                    color = Color.White,
                    fontSize = 11.sp
                )
            }
        }
    }
}

