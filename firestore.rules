rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profile fields remain editable by their owner. Wallet and verified purchase
    // totals are server-owned; Admin SDK writes bypass these client rules.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(
                      ['coins', 'diamonds', 'lifetimeEligibleTopUp']);
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                      ['coins', 'diamonds', 'lifetimeEligibleTopUp']);
      allow delete: if false;
    }

    // Immutable referral relationship. The invitee creates exactly one record,
    // while an inviter may query only records pointing to their own UID.
    match /referrals/{inviteeUid} {
      allow get: if request.auth != null
                 && (request.auth.uid == inviteeUid
                     || resource.data.inviterUid == request.auth.uid);
      allow list: if request.auth != null
                  && resource.data.inviterUid == request.auth.uid;
      allow create: if request.auth != null
                    && request.auth.uid == inviteeUid
                    && request.resource.data.keys().hasOnly(['inviterUid', 'inviteeUid', 'createdAt'])
                    && request.resource.data.inviteeUid == request.auth.uid
                    && request.resource.data.inviterUid is string
                    && request.resource.data.inviterUid.size() > 0
                    && request.resource.data.inviterUid != request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && exists(/databases/$(database)/documents/users/$(request.resource.data.inviterUid));
      allow update, delete: if false;
    }

    // Party Rooms
    match /partyRooms/{roomId} {

      // Logged-in users can see available rooms
      allow read: if request.auth != null;

      // Only the creator can create a room as host
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;

      // Only the real host can change/delete room controls
      allow update: if request.auth != null
                    && (
                      resource.data.hostUid == request.auth.uid

                      ||

                      (
                        exists(
                          /databases/$(database)/documents/partyRooms/$(roomId)/members/$(request.auth.uid)
                        )
                        && request.resource.data.hostUid == request.auth.uid
                        && resource.data.hostLastSeen is timestamp
                        && request.time - resource.data.hostLastSeen
                           >= duration.value(90, 's')
                      )
                    );

      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;

      // Room members
      // Atomic seat locks
      match /seats/{seatId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid;

        allow update: if request.auth != null
                      && resource.data.uid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid;

        allow delete: if request.auth != null
                      && resource.data.uid == request.auth.uid;
      }

      match /members/{memberId} {

        // Logged-in users can see who is inside the room
        allow read: if request.auth != null;

        // A user can create/change/remove only their own member document
        allow create, update, delete: if request.auth != null
                                     && request.auth.uid == memberId;
      }
    }
  }
}
