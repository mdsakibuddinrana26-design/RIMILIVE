rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Party Rooms
    match /partyRooms/{roomId} {

      // Logged-in users can see available rooms
      allow read: if request.auth != null;

      // Only the creator can create a room as host
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;

      // Only the real host can change/delete room controls
      allow update: if request.auth != null
                    && (
                      resource.data.hostUid == request.auth.uid

                      ||

                      (
                        exists(
                          /databases/$(database)/documents/partyRooms/$(roomId)/members/$(request.auth.uid)
                        )
                        && request.resource.data.hostUid == request.auth.uid
                        && resource.data.hostLastSeen is timestamp
                        && request.time - resource.data.hostLastSeen
                           >= duration.value(90, 's')
                      )
                    );

      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;

      // Room members
      // Atomic seat locks
      match /seats/{seatId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid;

        allow update: if request.auth != null
                      && resource.data.uid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid;

        allow delete: if request.auth != null
                      && resource.data.uid == request.auth.uid;
      }

      match /members/{memberId} {

        // Logged-in users can see who is inside the room
        allow read: if request.auth != null;

        // A user can create/change/remove only their own member document
        allow create, update, delete: if request.auth != null
                                     && request.auth.uid == memberId;
      }
    }
  }
}
